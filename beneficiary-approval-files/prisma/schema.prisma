// Church Welfare Management System - Database Schema
// Using SQLite for zero-config local development.
// Swap the datasource to postgresql/mysql for production - models are portable.
//
// NOTE ON ENUMS: SQLite's Prisma connector does not support native `enum`
// types (P1012). Every field that would otherwise be an enum is stored as a
// plain String column holding one of a fixed set of values instead. Those
// value sets are defined once in src/lib/enums.ts and used everywhere in the
// app for type safety - the database itself just stores the string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  contributionsRecorded Contribution[]
  casesCreated          ContributionCase[]
}

model Member {
  id               String   @id @default(cuid())
  membershipNumber String   @unique
  fullName         String
  phone            String   @unique
  email            String?  @unique
  status           String   @default("ACTIVE") // MemberStatus: ACTIVE | SUSPENDED
  missedCount      Int      @default(0)
  dateJoined       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  beneficiaries   Beneficiary[]
  affectedInCases ContributionCase[] @relation("AffectedMember")
  contributions   Contribution[]
}

model Beneficiary {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String
  phone        String? // collected when a member self-submits a beneficiary
  status       String   @default("ACTIVE") // BeneficiaryStatus: PENDING_APPROVAL | ACTIVE | REJECTED | ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cases ContributionCase[]
}

model ContributionCase {
  id               String      @id @default(cuid())
  beneficiaryId    String
  beneficiary      Beneficiary @relation(fields: [beneficiaryId], references: [id])
  affectedMemberId String
  affectedMember   Member      @relation("AffectedMember", fields: [affectedMemberId], references: [id])
  amountPerMember  Int         @default(300) // fixed contribution, KSh, never editable
  deadline         DateTime
  status           String      @default("OPEN") // CaseStatus: OPEN | CLOSED
  createdById      String
  createdBy        Admin       @relation(fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  closedAt         DateTime?
  notes            String?

  contributions Contribution[]
}

// One row per eligible member per case - created when the case opens.
model Contribution {
  id           String           @id @default(cuid())
  caseId       String
  case         ContributionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id])
  amount       Int              @default(300)
  status       String           @default("PENDING") // PaymentStatus: PENDING | PAID | LAPSED | WAIVED
  paidAt       DateTime?
  recordedById String?
  recordedBy   Admin?           @relation(fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())

  @@unique([caseId, memberId])
}

model OtpCode {
  id         String   @id @default(cuid())
  identifier String // email or phone the code was issued to
  purpose    String // OtpPurpose: ADMIN_LOGIN | MEMBER_LOGIN
  codeHash   String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier, purpose])
}

// Notification placeholders - no real SMS/Email provider wired up yet.
// Swap ConsoleNotificationProvider for a real provider later without
// touching any calling code (see src/lib/notifications.ts).
model Notification {
  id            String    @id @default(cuid())
  recipientType String // RecipientType: ADMIN | MEMBER
  recipientId   String
  channel       String // NotificationChannel: EMAIL | SMS
  type          String // e.g. "OTP", "CASE_OPENED", "DEADLINE_REMINDER", "SUSPENSION"
  payload       String // JSON string
  status        String    @default("PENDING") // NotificationStatus: PENDING | SENT | FAILED
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
}
