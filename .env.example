# SQLite file-based database - zero config for local development.
# Swap the provider in prisma/schema.prisma to postgresql/mysql for production
# and point this at that connection string instead.
DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Generate a real random string for production,
# e.g.: openssl rand -base64 32
SESSION_SECRET="dev-only-insecure-secret-change-me"

# --- SMS provider (Hazi SMS) -------------------------------------------
# Not required for the app to run or compile. Leave unset and every SMS
# (including OTPs) will honestly report "provider not configured" instead
# of pretending to send. See src/lib/providers/smsProvider.ts.
HAZI_SMS_API_KEY=
HAZI_SMS_API_URL=
HAZI_SMS_SENDER_ID=

# --- Email provider -------------------------------------------------------
# Not required for the app to run or compile. Leave unset and every email
# (including OTPs) will honestly report "provider not configured" instead
# of pretending to send. See src/lib/providers/emailProvider.ts.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Scheduled jobs ---------------------------------------------------
# Shared secret for the deadline-reminder cron endpoint
# (/api/cron/deadline-reminders). Required in production - the endpoint
# rejects requests without it. Generate with e.g.: openssl rand -hex 32
CRON_SECRET=

# --- App base URL -------------------------------------------------------
# Used to build absolute links in emails (e.g. the disbursement approval
# link sent to approvers, who have no account and act only through that
# link). Defaults to http://localhost:3000 if unset.
APP_URL=

# --- Tamasha authentication integration ---------------------------------
# The organization's real backend is the source of truth for verifying an
# admin's email/password (see src/lib/tamashaClient.ts). No API key is
# needed to call it - it authenticates the end user's own credentials, not
# this app. Safe to leave TAMASHA_API_URL/TAMASHA_GUARD_NAME unset; they
# default to the values below.
TAMASHA_API_URL=https://api.tamashaportal.co.ke/api/v1/
TAMASHA_GUARD_NAME=estate
